#!/bin/sh
# Pre-commit quality gate: run slopwatch exactly as the CI workflow does
# (see .github/actions/build-test -> "Check code quality"), so a commit cannot
# introduce what CI would later reject.
#
# Enable in a fresh clone with:
#   git config core.hooksPath .githooks
#
# Bypass for a single commit (use sparingly) with `git commit --no-verify`.

# Run from the repo root regardless of where `git commit` was invoked.
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# Make the pinned slopwatch tool available; quiet on success, loud on failure.
if ! dotnet tool restore >/dev/null; then
    echo "pre-commit: 'dotnet tool restore' failed - cannot run the quality gate." >&2
    exit 1
fi

echo "pre-commit: running slopwatch quality gate..."
if ! dotnet slopwatch analyze --fail-on warning; then
    echo "pre-commit: slopwatch found issues (fail-on warning). Commit aborted." >&2
    echo "pre-commit: fix them, or bypass this one commit with 'git commit --no-verify'." >&2
    exit 1
fi
