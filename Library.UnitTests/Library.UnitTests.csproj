<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One leg per shipped library asset. netstandard2.0 cannot be targeted directly (it is a
         reference contract, not a runtime), so net7.0-windows stands in for it: net8.0-windows is
         too new for a net7 consumer and net48 is incompatible, leaving netstandard2.0 as the only
         asset NuGet can pick. LoadedLibraryAssetTests asserts that at runtime. -->
    <TargetFrameworks>net48;net7.0-windows;net8.0-windows</TargetFrameworks>

    <!-- RUN THE LEGS SERIALLY: `dotnet test -m:1`. Each target framework runs in its own
         process, and the hardware tests drive the machine's real default endpoint - master and
         per-channel volume, mute. [NonParallelizable] only orders fixtures within one assembly,
         so without -m:1 the legs fight over the same endpoint and the volume-notification tests
         fail intermittently. -->

    <!-- `Major`, not `LatestMajor`: LatestMajor jumps to the newest installed runtime even when an
         exact match exists, which would run every leg on the same runtime and defeat the split.
         `Major` uses 7.0 and 8.0 when present and only rolls forward if one is missing. -->
    <RollForward>Major</RollForward>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>AudioDeviceLib.UnitTests</RootNamespace>
    <AssemblyName>AudioDeviceLib.UnitTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="Verify.NUnit" />
  </ItemGroup>

  <!-- Only the .NET Core legs need this: the .NET Framework leg uses a different NUnit engine
       that does not load DependencyModel. See the note in Directory.Packages.props. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
  </ItemGroup>

  <!-- Build-time-only: lets the .NET SDK compile the net48 target without a machine-wide
       .NET Framework Developer Pack. No runtime dependency (PrivateAssets=all). -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library\AudioDeviceLib.csproj" />
  </ItemGroup>

