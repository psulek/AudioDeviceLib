<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0;net8.0-windows</TargetFrameworks>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>

    <EnableComHosting>false</EnableComHosting>

    <RootNamespace>AudioDeviceLib</RootNamespace>
    <AssemblyName>AudioDeviceLib</AssemblyName>

    <Product>AudioDeviceLib</Product>
    <Description>Managed library to enumerate Windows audio devices and set the default playback/recording device, plus volume and mute control.
      Targets .NET Framework 4.8, .NET Standard 2.0 and .NET 8 (Windows).
      Core Audio interop derived from AudioDeviceCmdlets (frgnca) / CoreAudioApi (Ray Molenkamp).
    </Description>
    <Version>1.0.0-rc.3</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/psulek/AudioDeviceLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/psulek/AudioDeviceLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>audio;wasapi;core-audio;default-audio-device;volume;mute;windows;com-interop</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Ship the repo-root README on the nuget.org package page (it lives one level up), and the
       third-party notices alongside it: the MIT terms this package incorporates require the notice
       to travel with every copy, including the binary one. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\MODIFICATIONS.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Build-time-only: lets the .NET SDK compile the net48 target without a machine-wide
       .NET Framework Developer Pack. No runtime dependency (PrivateAssets=all). -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AudioDeviceLib.UnitTests" />
  </ItemGroup>

</Project>
