<Project>
  <PropertyGroup>
    <CopyrightYear>$([System.DateTime]::Now.ToString('yyyy'))</CopyrightYear>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Peter Šulek</Authors>
    <Copyright>Copyright © $(CopyrightYear) $(Authors). Portions (c) 2016-2022 Francois Gendron (MIT) and (c) 2007-2010 Ray Molenkamp (zlib-style).</Copyright>
    <Version>1.0.0-rc.3</Version>

    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>