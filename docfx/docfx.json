{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "Library/AudioDeviceLib.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0-windows",
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**/*.yml",
          "api/index.md",
          "articles/**/*.md",
          "articles/**/toc.yml",
          "index.md",
          "toc.yml"
        ]
      }
    ],
    "dest": "../_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "AudioDeviceLib",
      "_appName": "AudioDeviceLib",
      "_enableSearch": true,
      "_lang": "en",
      "_gitContribute": {
        "repo": "https://github.com/psulek/AudioDeviceLib",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://psulek.github.io/AudioDeviceLib/"
    }
  }
}
